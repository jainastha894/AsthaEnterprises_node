      <script>
        // Scroll to categories when button is clicked
        function scrollToCategories() {
          const categoriesSection = document.querySelector('.categories-section');
          categoriesSection.scrollIntoView({ behavior: 'smooth' });
        }

        // Show all categories function - clear filter and scroll to products
        function showAllCategories() {
          // Clear existing filter and show all products
          const categoryBoxes = document.querySelectorAll('.category-box');
          categoryBoxes.forEach(box => {
            box.classList.remove('hidden');
          });

          // Clear search input and reset filter state
          state.search = '';
          if (searchInput) {
            searchInput.value = '';
          }

          // Show all products (clear filter)
          renderProducts(applySort(PRODUCTS));

          // Scroll to products section
          const productsSection = document.getElementById('products');
          if (productsSection) {
            productsSection.scrollIntoView({ behavior: 'smooth' });
          }
        }

        // Add click handlers for category boxes - filter and scroll to products
        document.querySelectorAll('.category-box').forEach(box => {
          box.addEventListener('click', function () {
            const categoryValue = this.getAttribute('data-category');
            if (!categoryValue) return;

            // Filter products by category
            const filteredProducts = PRODUCTS.filter(p => {
              if (!p.units || !p.units.categoryList) {
                return false;
              }
              return p.units.categoryList.some(cat =>
                cat.toLowerCase().includes(categoryValue.toLowerCase())
              );
            });

            // Apply sort and render filtered products
            const sortedFiltered = applySort(filteredProducts);
            renderProducts(sortedFiltered);

            // Scroll to products section
            const productsSection = document.getElementById('products');
            if (productsSection) {
              productsSection.scrollIntoView({ behavior: 'smooth' });
            }

            console.log('Selected category:', categoryValue, 'Products found:', filteredProducts.length);
          });
        });
      </script>

      <script>

        // Define applySort function before using it
        function applySort(productsToSort) {
          const sortValue = state.sort || (sortSelect ? sortSelect.value : 'newest');
          let sortedProducts = [...productsToSort];

          if (sortValue === "name") {
            sortedProducts.sort((a, b) =>
              a.name.localeCompare(b.name)
            );
          } else if (sortValue === "newest") {
            sortedProducts.sort((a, b) => {
              const dateA = a.createdAt ? new Date(a.createdAt) : new Date(0);
              const dateB = b.createdAt ? new Date(b.createdAt) : new Date(0);
              return dateB - dateA;
            });
          }

          return sortedProducts;
        }

