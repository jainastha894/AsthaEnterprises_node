            <style>
              * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
              }

              body {
                font-family: 'Arial', sans-serif;
                background-color: #f5f5f5;
              }

              /* Navigation Bar */
              .navbar {
                background-color: #1a1a1a;
                padding: 20px 40px;
                display: flex;
                justify-content: space-between;
                align-items: center;
              }

              /* Video Section */
              .video-section {
                width: 100%;
                height: 300px;
                overflow: hidden;
                position: relative;
              }

              .video-section video {
                width: 100%;
                height: 300px;
                object-fit: cover;
              }

              .video-button {
                background-color: #ffffff;
                color: #461f1f;
                padding: 20px 50px;
                font-size: 24px;
                font-weight: bold;
                border: none;
                cursor: pointer;
                transition: all 0.3s ease;
                text-transform: uppercase;
                letter-spacing: 1px;
              }

              .video-button:hover {
                background-color: #333;
                color: #ffffff;
                padding: 22px 55px;
              }

              /* Categories Section */
              .categories-section {
                max-width: 1400px;
                margin: 0 auto;
                padding: 20px 15px 50px;
              }

              .section-title {
                font-size: 32px;
                font-weight: bold;
                color: #1a1a1a;
                margin-bottom: 15px;
                text-align: center;
                display: none;
              }

              /* All Categories Full Width Box */
              .all-categories-box {
                position: relative;
                height: 120px;
                overflow: hidden;
                cursor: pointer;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
                margin-bottom: 10px;

              }

              .all-categories-box:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
              }

              .all-categories-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
              }

              /* Category Grid */
              .category-grid {
                display: grid;
                grid-template-columns: repeat(5, 1fr);
                gap: 10px;
                margin-top: 10px;
              }

              .category-box {
                position: relative;
                height: 250px;
                border-radius: 0px;
                overflow: hidden;
                cursor: pointer;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
              }

              .category-box:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
              }

              .category-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
              }

              .category-overlay {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(to bottom, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.6));
                display: flex;
                align-items: center;
                justify-content: center;
              }

              .category-name {
                color: #fff;
                font-size: 24px;
                font-weight: bold;
                text-transform: uppercase;
                letter-spacing: 1px;
                text-align: center;
                text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
              }

              .category-box.hidden {
                display: none;
              }

              /* Our Range Section */
              .our-range-section {
                margin-top: 30px;
                padding: 0 15px;
                text-align: center;
              }

              .our-range-title {
                font-size: 36px;
                font-weight: bold;
                color: #000;
                text-transform: uppercase;
                letter-spacing: 2px;
                margin-bottom: 20px;
              }

              /* Responsive Design */
              @media (max-width: 1200px) {
                .category-grid {
                  grid-template-columns: repeat(4, 1fr);
                }
              }

              @media (max-width: 900px) {
                .category-grid {
                  grid-template-columns: repeat(3, 1fr);
                }

                .navbar {
                  padding: 15px 20px;
                }

                .categories-section {
                  padding: 0 15px 40px;
                }
              }

              @media (max-width: 600px) {
                .category-grid {
                  grid-template-columns: repeat(3, 1fr);
                  gap: 8px;
                }

                .category-box {
                  height: 180px;
                }

                /* Mobile screen */
                @media (max-width: 768px) {
                  .category-box {
                    height: 90px;
                  }

                  .category-name {
                    font-size: 4px;
                  }
                }


                .category-name {
                  font-size: 16px;

                }


                .section-title {
                  font-size: 24px;
                }

                .categories-section {
                  padding: 0 15px 30px;
                }

                .all-categories-box {
                  height: 100px;
                }

                .video-button {
                  padding: 15px 35px;
                  font-size: 18px;
                }

                .video-button:hover {
                  padding: 16px 38px;
                }

                .our-range-title {
                  font-size: 28px;
                }
              }
            </style>
</head>
