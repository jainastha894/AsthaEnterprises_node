    <%- include ('partials/footer.ejs') %>

      <script>

        // Reveal on scroll
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('show'); io.unobserve(e.target); } })
        }, { threshold: .15 });
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));

        // Form validation + success
        document.getElementById('contactForm').addEventListener('submit', (e) => {
          e.preventDefault();
          // reset
          document.querySelectorAll('.error-message').forEach(m => { m.classList.add('hidden'); m.textContent = ''; });
          document.querySelectorAll('.form-input').forEach(i => { i.classList.remove('error', 'success'); });

          const required = ['firstName', 'lastName', 'email', 'subject', 'message'];
          let ok = true;

          required.forEach(id => {
            const el = document.getElementById(id);
            const err = el.parentNode.querySelector('.error-message');
            if (!el.value.trim()) {
              el.classList.add('error'); err.textContent = 'This field is required'; err.classList.remove('hidden'); ok = false;
            } else {
              el.classList.add('success');
            }
          });
          const email = document.getElementById('email');
          const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (email.value && !re.test(email.value)) {
            email.classList.remove('success'); email.classList.add('error');
            const err = email.parentNode.querySelector('.error-message');
            err.textContent = 'Please enter a valid email'; err.classList.remove('hidden'); ok = false;
          }

          if (ok) {
            const btn = e.target.querySelector('button[type="submit"]');
            const txt = btn.textContent;
            btn.textContent = 'Sending...';
            btn.disabled = true;

            // Collect form data
            const formData = {
              firstName: document.getElementById('firstName').value.trim(),
              lastName: document.getElementById('lastName').value.trim(),
              email: document.getElementById('email').value.trim(),
              phone: document.getElementById('phone').value.trim(),
              subject: document.getElementById('subject').value,
              message: document.getElementById('message').value.trim()
            };

            // Submit to server
            fetch('/contact', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(formData)
            })
              .then(response => response.json())
              .then(data => {
                if (data.success) {
                  e.target.classList.add('hidden');
                  document.getElementById('successMessage').classList.remove('hidden');
                } else {
                  alert(data.message || 'Error sending message. Please try again.');
                  btn.textContent = txt;
                  btn.disabled = false;
                }
              })
              .catch(error => {
                console.error('Error:', error);
                alert('Error sending message. Please try again.');
                btn.textContent = txt;
                btn.disabled = false;
              });
          }
        });

        // FAQ toggle
        function toggleFAQ(btn) {
          const content = btn.parentNode.querySelector('.faq-content');
          const icon = btn.querySelector('svg');
          const hidden = content.classList.contains('hidden');
          document.querySelectorAll('.faq-content').forEach(c => c !== content && c.classList.add('hidden'));
          document.querySelectorAll('.faq-content + .dummy').forEach(() => { });
          content.classList.toggle('hidden', !hidden ? true : false);
          icon.style.transform = hidden ? 'rotate(180deg)' : 'rotate(0deg)';
        }

        // Maps opener (opens in new tab)
        function openMaps() {
          const q = encodeURIComponent('Astha Enterprises, 9/5166 ch. Gynendra Singh market, Gali No. 1, Gandhi Nagar, Shanti Mohalla, Delhi, 110031');
          window.open('https://www.google.com/maps/search/?api=1&query=' + q, '_blank');
        }

        window.openMaps = openMaps; // expose for inline handler
      </script>
