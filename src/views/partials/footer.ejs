    <script>
        (function () {
            // Set current year dynamically
            const yearElement = document.getElementById('ae-current-year');
            if (yearElement) {
                yearElement.textContent = new Date().getFullYear();
            }

            // Smooth scroll to top functionality (optional)
            const footerLinks = document.querySelectorAll('.ae-footer-link, .ae-footer-bottom-link');
            footerLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    // If link is to same page with hash
                    if (this.hash !== '') {
                        e.preventDefault();
                        const hash = this.hash;
                        const target = document.querySelector(hash);
                        if (target) {
                            target.scrollIntoView({
                                behavior: 'smooth',
                                block: 'start'
                            });
                        }
                    }
                });
            });
        })();
