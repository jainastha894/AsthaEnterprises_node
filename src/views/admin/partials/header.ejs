<script src="https://cdn.tailwindcss.com"></script>
<script src="/js/theme-switcher.js"></script>

<!-- Fixed Header -->

<header class="dashboard-header">
    <div class="header-left">
        <button class="hamburger-btn" id="hamburgerBtn">☰</button>
    </div>
    <div class="header-center">
        <div class="company-name">Astha Enterprises</div>
        <div class="panel-subtitle">Admin Panel</div>
    </div>
    <div class="header-right">
        

        <!-- Theme Toggle Button -->
        <button class="theme-toggle-btn" id="themeToggle" title="Switch theme">
            <span class="theme-icon">🌙</span>
            <span class="theme-text">Dark</span>
        </button>

        <a href="/admin/logout">
            <button class="logout-circle-btn" id="headerLogoutBtn" title="Logout">
                🚪
            </button>
        </a>

    </div>
</header>